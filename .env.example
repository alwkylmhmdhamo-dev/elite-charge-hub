# Frontend\nVITE_API_BASE_URL=http://localhost:5000\n\n# Backend\nPORT=5000\nMONGODB_URI=mongodb://localhost:27017/elite-charge\n\n# JWT\nJWT_SECRET=your-super-secret-jwt-key-change-this\nJWT_EXPIRE=7d\n\n# Payment Gateway\nSYRIATEL_MERCHANT_ID=your-merchant-id\nSYRIATEL_API_KEY=your-api-key\nKASIH_API_KEY=your-kasih-key\nSHAAME_API_KEY=your-shaame-key\n\n# Email\nEMAIL_SERVICE=gmail\nEMAIL_USER=your-email@gmail.com\nEMAIL_PASS=your-email-password\n\n# Environment\nNODE_ENV=development\n